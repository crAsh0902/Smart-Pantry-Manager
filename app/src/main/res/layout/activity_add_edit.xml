<?xml version="1.0" encoding="utf-8"?>



<!-- AddEditActivity.java -->



<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">



        <!-- IngredientTitle -> Ingredient INFORMATION -->
        <TextView
            android:id="@+id/txtIngTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADD YOUR INGREDIENT"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingBottom="24dp" />



        <!-- Name. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name of Ingredient"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtIngName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Tomato"
            android:inputType="text"
            android:layout_marginBottom="16dp" />



        <!-- Quantity. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quantity Of Ingredient"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtIngQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 5"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />



        <!-- Unit. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unit of Ingredient"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtIngUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. pieces"
            android:inputType="text"
            android:layout_marginBottom="16dp" />



        <!-- ExpirationDate. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredient's Expiry Date"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtIngExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Optional - YYYY-MM-DD"
            android:inputType="text"
            android:layout_marginBottom="24dp" />



        <!-- SAVE Ingredient. -->
        <Button
            android:id="@+id/btnSaveIng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE" />
    </LinearLayout>

</ScrollView>